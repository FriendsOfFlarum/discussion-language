{
  "extends": "flarum-tsconfig",
  "include": [
    "src/**/*",
    "../vendor/*/*/js/dist-typings/@types/**/*",
    "../vendor/flarum/**/js/dist-typings/@types/**/*"
  ],
  "compilerOptions": {
    "types": [],
    "declarationDir": "./dist-typings",
    "baseUrl": ".",
    "paths": {
      "flarum/*": [
        "../vendor/flarum/core/js/dist-typings/*"
      ],
      "ext:flarum/tags/*": [
        "../vendor/flarum/tags/js/dist-typings/*"
      ],
      "ext:fof/follow-tags/*": [
        "../vendor/fof/follow-tags/js/dist-typings/*"
      ]
    }
  }
}
